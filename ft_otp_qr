#!/usr/bin/env python3

import argparse
import base64
import hashlib
import hmac
import os
import secrets
import struct
import sys
import time
from pathlib import Path
from urllib.parse import quote

try:
    import qrcode
except ImportError:
    qrcode = None


KEY_FILE_NAME = "ft_otp.key"
QR_FILE_NAME = "ft_otp_qr.png"
ERROR_KEY = "./ft_otp_qr: error: key must be 64 hexadecimal characters."
ERROR_USAGE = "Usage: ./ft_otp_qr -g <key_file> | -k <encrypted_key_file> | -q"
ERROR_QR = "./ft_otp_qr: error: qrcode library is required for QR generation."
BLOCK_SIZE = 30
DIGITS = 6
ISSUER = "ft_otp"
ACCOUNT = "ft_otp"


def xor_bytes(data: bytes) -> bytes:
    mask = hashlib.sha256(b"ft_otp").digest()
    return bytes(byte ^ mask[index % len(mask)] for index, byte in enumerate(data))


def validate_hex_key(text: str) -> bytes:
    key = text.strip()
    if len(key) < 64 or len(key) % 2 != 0:
        raise ValueError
    if any(char not in "0123456789abcdefABCDEF" for char in key):
        raise ValueError
    return bytes.fromhex(key)


def encrypt_and_store_key(key_bytes: bytes) -> None:
    encrypted = base64.b64encode(xor_bytes(key_bytes))
    Path(KEY_FILE_NAME).write_bytes(encrypted)
    try:
        os.chmod(KEY_FILE_NAME, 0o600)
    except OSError:
        pass


def save_key(source_path: Path) -> None:
    try:
        raw_text = source_path.read_text(encoding="utf-8")
        key_bytes = validate_hex_key(raw_text)
    except (OSError, ValueError):
        print(ERROR_KEY)
        sys.exit(1)

    encrypt_and_store_key(key_bytes)
    print(f"Key was successfully saved in {KEY_FILE_NAME}.")


def load_key(key_path: Path) -> bytes:
    try:
        encrypted = key_path.read_bytes()
        key_bytes = xor_bytes(base64.b64decode(encrypted, validate=True))
    except (OSError, ValueError, base64.binascii.Error):
        print(ERROR_USAGE)
        sys.exit(1)

    if len(key_bytes) < 32:
        print(ERROR_USAGE)
        sys.exit(1)
    return key_bytes


def hotp(secret: bytes, counter: int) -> int:
    message = struct.pack(">Q", counter)
    digest = hmac.new(secret, message, hashlib.sha1).digest()
    offset = digest[-1] & 0x0F
    code = struct.unpack(">I", digest[offset:offset + 4])[0] & 0x7FFFFFFF
    return code % (10 ** DIGITS)


def generate_otp(key_path: Path) -> None:
    secret = load_key(key_path)
    counter = int(time.time()) // BLOCK_SIZE
    otp = hotp(secret, counter)
    print(f"{otp:0{DIGITS}d}")


def otpauth_uri(secret_hex: str) -> str:
    label = quote(f"{ISSUER}:{ACCOUNT}")
    issuer = quote(ISSUER)
    return f"otpauth://totp/{label}?secret={secret_hex}&issuer={issuer}&digits={DIGITS}&period={BLOCK_SIZE}"


def generate_qr_image(uri: str) -> None:
    if qrcode is None:
        print(ERROR_QR)
        sys.exit(1)

    qr = qrcode.QRCode(
        version=None,
        error_correction=qrcode.constants.ERROR_CORRECT_M,
        box_size=10,
        border=4,
    )
    qr.add_data(uri)
    qr.make(fit=True)
    image = qr.make_image(fill_color="black", back_color="white")
    image.save(QR_FILE_NAME)


def generate_seed() -> None:
    secret_hex = secrets.token_hex(32)
    encrypt_and_store_key(bytes.fromhex(secret_hex))
    generate_qr_image(otpauth_uri(secret_hex))
    print(f"Seed generated and saved in {KEY_FILE_NAME}.")
    print(f"QR code saved in {QR_FILE_NAME}.")
    print(secret_hex)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="./ft_otp_qr",
        description="Store a hex key, generate an OTP, or create a QR code with a new seed.",
    )
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("-g", metavar="KEY_FILE", help="Read and save hex key from KEY_FILE")
    group.add_argument("-k", metavar="FT_OTP_KEY", help="Generate OTP from saved FT_OTP_KEY file")
    group.add_argument("-q", action="store_true", help="Generate a new seed and QR code")
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    if args.g:
        save_key(Path(args.g))
    elif args.k:
        generate_otp(Path(args.k))
    elif args.q:
        generate_seed()
    else:
        print(ERROR_USAGE)
        sys.exit(1)


if __name__ == "__main__":
    main()